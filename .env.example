# Optional PostgreSQL service; use your own local secret.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://entitybridge:REPLACE_ME@127.0.0.1:5432/entitybridge
# For `entitybridge serve`. Use different unpredictable tokens per role.
ENTITYBRIDGE_TOKENS={"REPLACE_ADMIN_TOKEN":["operator","admin"],"REPLACE_REVIEW_TOKEN":["reviewer","reviewer"],"REPLACE_VIEW_TOKEN":["auditor","viewer"]}
